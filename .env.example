# Copie este arquivo para .env e preencha os valores.
# NUNCA faça commit do .env (ele está no .gitignore). Chave publicada = chave vazada.

# Token do GitHub para o MCP do GitHub.
# Fine-grained (recomendado) com acesso a Contents, Issues e Pull requests do repositório,
# ou classic com escopo "repo". Permissões mínimas.
GITHUB_PAT=

# Chave da API do Figma para o MCP do Figma (opcional).
FIGMA_API_KEY=

# Chave da API de IA usada pelo assistente no servidor (fase de deploy no Railway).
IA_API_KEY=
